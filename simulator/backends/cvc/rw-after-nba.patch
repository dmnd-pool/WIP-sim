+/* RW callbacks have their own phase. Reuse the existing typed callback
+ * lists; only the scheduler's quiescent boundary transfers this batch. */
+static void md_sim_queue_rw_sync(struct tev_t *tevp)
+{
+ tevp->tenxtp = NULL;
+ if (__vpicb_tehdri[cbReadWriteSynch] == NULL)
+  __vpicb_tehdri[cbReadWriteSynch] = tevp;
+ else __vpicb_teendi[cbReadWriteSynch]->tenxtp = tevp;
+ __vpicb_teendi[cbReadWriteSynch] = tevp;
+}
+
+extern struct tev_t *__md_sim_take_rw_sync(void)
+{
+ struct tev_t *head, *tail;
+ head = __vpicb_tehdri[cbReadWriteSynch];
+ if (head == NULL) return(NULL);
+ if (__p0_te_hdrp != NULL || __p0_te_endp != NULL)
+  __vpi_terr(__FILE__, __LINE__);
+ tail = __vpicb_teendi[cbReadWriteSynch];
+ if (tail == NULL) __vpi_terr(__FILE__, __LINE__);
+ __vpicb_tehdri[cbReadWriteSynch] = NULL;
+ __vpicb_teendi[cbReadWriteSynch] = NULL;
+ __p0_te_hdrp = head;
+ __p0_te_endp = tail;
+ tail->tenxtp = __compiled_sim ? __free_event_pnd0_tevp : NULL;
+ return(head);
+}
