+static void esp32s3_uart_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3UARTClass *class = ESP32S3_UART_GET_CLASS(obj);
+    ESP32S3UARTState *s = ESP32S3_UART(obj);
+
+    if (class->parent_reset_phases.hold) {
+        class->parent_reset_phases.hold(obj, type);
+    }
+    s->clk_conf = ESP32S3_UART_CLK_CONF_RESET;
+    s->date = ESP32S3_UART_DATE_RESET;
+}
