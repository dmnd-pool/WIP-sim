+/* Register observations only. This does not establish a physical baud rate.
+ * Keep the trace bounded even when firmware repeatedly resets the device. */
+static void esp32s3_uart_trace_config(ESP32S3UARTState *s, hwaddr addr,
+                                     uint64_t value, unsigned size,
+                                     uint32_t stored)
+{
+    if (s->config_trace_count > ESP32S3_UART_CONFIG_TRACE_LIMIT) {
+        return;
+    }
+    g_autofree char *path = object_get_canonical_path(OBJECT(s));
+    int64_t virtual_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    assert(path != NULL);
+    if (s->config_trace_count == ESP32S3_UART_CONFIG_TRACE_LIMIT) {
+        trace_esp32s3_uart_config_overflow(path, virtual_ns,
+                                         ESP32S3_UART_CONFIG_TRACE_LIMIT);
+    } else {
+        trace_esp32s3_uart_config_write(path, virtual_ns, s->config_trace_count,
+                                      addr, size, value, stored);
+    }
+    s->config_trace_count++;
+}
 
