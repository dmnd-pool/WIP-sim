+/* Explicit repeated-START selection for controllers with an address phase.
+ * Do not call i2c_end_transfer: STOP can commit data in a slave device and
+ * release bus ownership. The original helper intentionally keeps current_devs
+ * for its existing callers, which is unsuitable for a changed address. */
+int i2c_start_transfer_reselect(I2CBus *bus, uint8_t address, bool is_recv)
+{
+    while (!QLIST_EMPTY(&bus->current_devs)) {
+        I2CNode *node = QLIST_FIRST(&bus->current_devs);
+        I2CSlaveClass *sc = I2C_SLAVE_GET_CLASS(node->elt);
+        if (sc->restart) { sc->restart(node->elt); }
+        QLIST_REMOVE(node, next);
+        g_free(node);
+    }
+    bus->broadcast = false;
+    return i2c_start_transfer(bus, address, is_recv);
+}
