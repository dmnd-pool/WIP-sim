+static void arm_mptimer_clock_update(void *opaque, ClockEvent event)
+{
+    ARMMPTimerState *s = opaque;
+    for (unsigned i = 0; i < s->num_cpu; i++) {
+        TimerBlock *tb = &s->timerblock[i];
+        if (!tb->timer) {
+            continue;
+        }
+        ptimer_transaction_begin(tb->timer);
+        /* PTimer retains its old period until this call. Freeze its count
+         * before replacing that period, including on a clock gate. */
+        ptimer_stop(tb->timer);
+        ptimer_set_period_from_clock(tb->timer, s->periphclk,
+                                      timerblock_scale(tb->control));
+        if (tb->armed && clock_is_enabled(s->periphclk)) {
+            ptimer_run(tb->timer, !(tb->control & 2));
+        }
+        ptimer_transaction_commit(tb->timer);
+    }
+}
+
