+/* Use the reference origin, not the last read, to retain fractional periods. */
+static int64_t a9_gtimer_deadline(A9GTimerState *s, uint64_t count)
+{
+    uint64_t ticks, ns, prescale = a9_gtimer_prescale(s);
+    if (count > UINT64_MAX / prescale) {
+        return INT64_MAX;
+    }
+    ticks = count * prescale;
+    ns = clock_ticks_to_ns(s->periphclk, ticks);
+    /* QEMU deadlines are whole ns. Round up so a callback cannot run early. */
+    if (ns < INT64_MAX && clock_ns_to_ticks(s->periphclk, ns) < ticks) {
+        ns++;
+    }
+    if (ns > INT64_MAX - s->cpu_ref_time) {
+        return INT64_MAX;
+    }
+    return s->cpu_ref_time + ns;
 }
 
