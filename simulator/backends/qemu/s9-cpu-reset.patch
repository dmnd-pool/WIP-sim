+/* Target-specific CPU integration for the generic SLCR signal pair. */
+typedef struct MdZynqCpuGate {
+    CPUState *cpu;
+    unsigned flags;
+} MdZynqCpuGate;
+
+static void md_zynq_cpu_work(CPUState *cs, run_on_cpu_data data)
+{
+    unsigned flags = data.host_int;
+    bool halt = flags & 3;
+    if (flags & 4) {
+        cpu_reset(cs);
+        ARMCPU *cpu = ARM_CPU(cs);
+        const struct arm_boot_info *info = cpu->env.boot_info;
+        if (info && info->is_linux) {
+            /* Direct-kernel entry already bypasses boot firmware. Preserve
+             * its declared security state after a secondary reset too.
+             * Raw SPL/ROM entry has no Linux boot_info and keeps reset state. */
+            arm_emulate_firmware_reset(cs, info->secure_boot ? 3 : 1);
+            arm_rebuild_hflags(&cpu->env);
+        }
+    }
+    arm_set_cpu_power_state(ARM_CPU(cs), halt ? PSCI_OFF : PSCI_ON);
+    cs->halted = halt;
+    cs->exception_index = halt ? EXCP_HLT : -1;
+    trace_md_sim_zynq_cpu_control(cs->cpu_index, flags & 1, !!(flags & 2));
+}
+
+static void md_zynq_cpu_gate(void *opaque, int n, int level)
+{
+    MdZynqCpuGate *gate = opaque;
+    unsigned flags = level & 3;
+    if (flags == gate->flags) {
+        return;
+    }
+    /* Reset only on assertion. Clock-only stops retain registers. */
+    if ((flags & 1) && !(gate->flags & 1)) {
+        flags |= 4;
+    }
+    gate->flags = level & 3;
+    async_run_on_cpu(gate->cpu, md_zynq_cpu_work, RUN_ON_CPU_HOST_INT(flags));
+}
+
+static void md_zynq_gate_reset(void *opaque)
+{
+    MdZynqCpuGate *gate = opaque;
+    /* SLCR reset register is zero. The CPU reset hook separately parks CPU1. */
+    gate->flags = 0;
+}
+
+/* Zynq secondary startup is performed through SLCR and the trampoline
+ * copied to address zero by the executing kernel. Do not install the generic
+ * RealView secondary ROM over the primary loader at that address. */
+static void md_zynq_secondary_loader(ARMCPU *cpu,
+                                     const struct arm_boot_info *info)
+{
+}
+static void md_zynq_secondary_reset(ARMCPU *cpu,
+                                    const struct arm_boot_info *info)
+{
+    arm_set_cpu_power_state(cpu, PSCI_OFF);
+    CPU(cpu)->halted = 1;
+}
