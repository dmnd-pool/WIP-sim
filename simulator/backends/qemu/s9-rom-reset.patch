+/* Public-ROM diagnostic mapping. This is separate from direct-SPL entry.
+ * The original ROM uses0x40000..0x7ffff before handoff. RAM_HI moves each
+ *64KiB bank to the documented high window. Private SWAP is not inferred. */
+typedef struct MdZynqRomMap {
+    MemoryRegion rom;
+    MemoryRegion bank[4];
+} MdZynqRomMap;
+
+static bool md_zynq_get_bootrom(Object *obj, Error **errp)
+{
+    return ZYNQ_MACHINE(obj)->md_bootrom_reference;
+}
+
+static void md_zynq_set_bootrom(Object *obj, bool value, Error **errp)
+{
+    ZynqMachineState *s = ZYNQ_MACHINE(obj);
+    if (s->cpu[0]) {
+        error_setg(errp, "bootrom-reference is immutable after initialization");
+        return;
+    }
+    s->md_bootrom_reference = value;
+}
+
+static void md_zynq_rom_map(void *opaque, int line, int value)
+{
+    MdZynqRomMap *s = opaque;
+    assert(value >= 0 && value <= 15);
+    memory_region_transaction_begin();
+    for (unsigned n = 0; n < 4; n++) {
+        hwaddr base = value & (1u << n) ? 0xfffc0000ULL : 0x40000ULL;
+        memory_region_set_address(&s->bank[n], base + n * 64 * KiB);
+    }
+    memory_region_transaction_commit();
+    trace_md_sim_zynq_rom_map(value);
+}
+
+static void md_zynq_rom_reset(void *opaque)
+{
+    /* Restore mapping only. Do not manufacture RAM contents on warm reset. */
+    md_zynq_rom_map(opaque, 0, 0);
+}
+
+static MdZynqRomMap *md_zynq_rom_init(MachineState *machine,
+                                    MemoryRegion *ocm)
+{
+    MdZynqRomMap *s = g_new0(MdZynqRomMap, 1);
+    MemoryRegion *memory = get_system_memory();
+    memory_region_init_rom(&s->rom, NULL, "md-sim.zynq.rom",
+                           128 * KiB, &error_fatal);
+    memory_region_add_subregion_overlap(memory, 0, &s->rom, 2);
+    if (load_image_mr(machine->firmware, &s->rom) != 128 * KiB) {
+        error_report("bootrom-reference requires a complete128KiB ROM");
+        exit(EXIT_FAILURE);
+    }
+    for (unsigned n = 0; n < 4; n++) {
+        g_autofree char *name = g_strdup_printf("md-sim.zynq.rom-ocm%u", n);
+        memory_region_init_alias(&s->bank[n], OBJECT(machine), name,
+                                 ocm, n * 64 * KiB, 64 * KiB);
+        memory_region_add_subregion_overlap(memory, 0x40000 + n * 64 * KiB,
+                                            &s->bank[n], 2);
+    }
+    qemu_register_reset(md_zynq_rom_reset, s);
+    return s;
 }
 
