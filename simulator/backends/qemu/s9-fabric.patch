+        unsigned div1 = extract32(ctrl, 20, 6);
+        uint64_t period = uart_mux[extract32(ctrl, 4, 2)] *
+                          (div0 ? div0 : 1) * (div1 ? div1 : 1);
+        if ((s->regs[base + 2] & 1) || s->regs[base + 1]) {
+            period = 0;
+        }
+        clock_set(s->fclk[n], period);
+    }
