+static void zynq_slcr_fabric_reset(ZynqSLCRState *s)
+{
+    for (unsigned n = 0; n < 4; n++) {
+        bool high = !device_is_in_reset(DEVICE(s)) &&
+                    !(s->regs[R_FPGA_RST_CTRL] & (1u << n));
+        qemu_set_irq(s->fclk_reset_n[n], high);
+        trace_md_sim_zynq_freset(n, high);
+    }
+}
