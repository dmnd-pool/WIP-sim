--- a/hw/arm/xilinx_zynq.c
+++ b/hw/arm/xilinx_zynq.c
@@ -305,2 +305,18 @@
+    if (object_dynamic_cast(OBJECT(machine), MACHINE_TYPE_NAME("md-sim-s9-gpio-development"))) {
+        /* Exact archived DT declares9 input pins and13 output pins.
+         * Default external inputs are tied low in this development fixture.
+         * No hashboard-presence or power-good success is synthesized. */
+        for (unsigned i = 0; i < 2; i++) {
+            DeviceState *gpio = qdev_new("md-sim-axi-gpio");
+            object_property_add_child(OBJECT(machine),
+                                      i ? "gpio-output" : "gpio-input", OBJECT(gpio));
+            qdev_prop_set_uint32(gpio, "width", i ? 13 : 9);
+            qdev_prop_set_uint32(gpio, "direction", i);
+            qdev_prop_set_uint32(gpio, "reset-data", 0);
+            qdev_prop_set_uint32(gpio, "reset-tri", UINT32_MAX);
+            sysbus_realize_and_unref(SYS_BUS_DEVICE(gpio), &error_fatal);
+            sysbus_mmio_map(SYS_BUS_DEVICE(gpio), 0, 0x41200000 + i * 0x10000);
+        }
+    }
     n = zynq_init_spi_flashes(0xE0006000, pic[58 - GIC_INTERNAL], false, 0);
     n = zynq_init_spi_flashes(0xE0007000, pic[81 - GIC_INTERNAL], false, n);
