+        .parent = MACHINE_TYPE_NAME("md-sim-s9-m69a-development"),
+    };
     static const TypeInfo onfi_fixture = {
@@ -515,3 +537,4 @@
     type_register_static(&fixture);
     type_register_static(&onfi_fixture);
+    type_register_static(&legacy_io);
 }
