+/* Timed adaptation: only the original storage functions modify flash.
+ * Pending data is separate from the live status/read buffer. A NAND RESET
+ * cancels the operation. PL353 register reset does not reset this chip. */
+static void md_nand_commit(void *opaque)
+{
+    NANDFlashState *s = opaque;
+    uint8_t io[sizeof(s->io)];
+    uint64_t addr = s->addr;
+    int iolen = s->iolen, offset = s->offset;
+    if (!s->md_pending) {
+        return;
+    }
+    memcpy(io, s->io, sizeof(io));
+    s->addr = s->md_addr;
+    s->iolen = s->md_iolen;
+    s->offset = s->md_offset;
+    memcpy(s->io, s->md_io, sizeof(s->io));
+    if (s->md_pending == NAND_CMD_PAGEPROGRAM2) {
+        s->blk_write(s);
+    } else {
+        s->blk_erase(s);
+    }
+    memcpy(s->io, io, sizeof(io));
+    s->addr = addr;
+    s->iolen = iolen;
+    s->offset = offset;
+    s->md_pending = 0;
+    s->md_deadline = 0;
+    s->status |= NAND_IOSTATUS_READY;
+    timer_del(s->md_timer);
+}
+
+void md_nand_tick(DeviceState *dev, uint64_t now)
+{
+    NANDFlashState *s = NAND(dev);
+    if (s->md_deadline && now >= s->md_deadline) {
+        md_nand_commit(s);
+    }
+}
+
+uint64_t md_nand_deadline(DeviceState *dev)
+{
+    return NAND(dev)->md_deadline;
+}
+
+static void md_nand_schedule(NANDFlashState *s, uint8_t command, uint64_t delay)
+{
+    s->status &= ~NAND_IOSTATUS_ERROR;
+    if (!s->wp || (s->addr >> s->addr_shift) >= s->pages) {
+        s->status |= NAND_IOSTATUS_ERROR;
+        return;
+    }
+    if (command == NAND_CMD_PAGEPROGRAM2 &&
+            (s->iolen < 0 || s->iolen > sizeof(s->io) || s->offset < 0 ||
+             (s->addr & ((1U << s->addr_shift) - 1)) + s->offset + s->iolen >
+             (1U << s->page_shift) + (1U << s->oob_shift))) {
+        s->status |= NAND_IOSTATUS_ERROR;
+        return;
+    }
+    s->md_addr = s->addr;
+    s->md_iolen = s->iolen;
+    s->md_offset = s->offset;
+    memcpy(s->md_io, s->io, sizeof(s->io));
+    s->md_pending = command;
+    s->md_deadline = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + delay;
+    s->status &= ~NAND_IOSTATUS_READY;
+    timer_mod_ns(s->md_timer, s->md_deadline);
 }
 
