  "adaptation": {
    "id": "fasm2bels-explicit-structure-v2",
    "component": "fasm2bels optional VPR and interchange imports",
    "reason": "Retain the optional import relocation; declare final alias sinks, assign the delay-free top a vendor 1 ps timebase, and render only four already omitted scalar RAMB36E1 inputs as explicit Z after requiring TDP18/36, ECC disabled and no cascade. Z preserves omission semantics; it is not a known physical tie. No routing, existing assignment, primitive parameter or existing port value changes.",
