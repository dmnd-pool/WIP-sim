        "result": {
          "path": "simulator/tools/fasm2bels/structure-v2/verilog_modeling.py",
          "object": {
            "sha256": "905488e90d3826602e759c47840d1bac709069585a36ec1ffaf3719e58769da0",
            "size": 89210
          }
        },
        "changes": [
          {
            "from": "from ..lib.interchange import create_site_routing\n",
            "to": ""
          },
          {
            "from": "        # Convert site_routing tree into Physical* object tree.\n",
            "to": "        from ..lib.interchange import create_site_routing\n\n        # Convert site_routing tree into Physical* object tree.\n"
          },
          {
            "from": "        yield 'module {}('.format(self.name)",
            "to": "        # Match the vendor model units; no physical delay is inferred.\n        yield '`timescale 1ps/1ps'\n        yield 'module {}('.format(self.name)"
          },
          {
            "from": "        for wire, width in make_bus(self.wires):\n            if width is None:\n                yield '  wire [0:0] {};'.format(wire)\n            else:\n                yield '  wire [{}:0] {};'.format(width, wire)\n\n",
            "to": ""
          },
          {
            "from": "        for site in self.sites:\n            for bel in sorted(site.bels, key=lambda bel: bel.priority):\n",
            "to": "        # Alias sinks are populated after routing. Declare them before use.\n        declared_wires = self.wires | (set(self.wire_name_net_map) -\n            self.root_in - self.root_out - self.root_inout)\n        for wire, width in make_bus(declared_wires):\n            if width is None:\n                yield '  wire [0:0] {};'.format(wire)\n            else:\n                yield '  wire [{}:0] {};'.format(width, wire)\n\n        for site in self.sites:\n            for bel in sorted(site.bels, key=lambda bel: bel.priority):\n"
          },
          {
            "from": "        if connections:\n            yield ',\\n'.join(\n                '.{}({})'.format(port, connections[port].to_string(net_map))\n                for port in sorted(connections))\n\n        yield '{indent});'.format(indent=indent)\n",
            "to": "        rendered = {port: connections[port].to_string(net_map)\n                    for port in connections}\n        if rendered:\n            yield ',\\n'.join('.{}({})'.format(port, rendered[port])\n                             for port in sorted(rendered))\n\n        yield '{indent});'.format(indent=indent)\n"
          },
          {
            "from": "        if rendered:\n",
            "to": "        if self.module == 'RAMB36E1':\n            assert self.parameters['RAM_MODE'] == '\"TDP\"'\n            widths = [self.parameters[key] for key in\n                      ('READ_WIDTH_A', 'READ_WIDTH_B', 'WRITE_WIDTH_A', 'WRITE_WIDTH_B')]\n            assert widths[0] in (18, 36) and len(set(widths)) == 1\n            for key, default in [('EN_ECC_READ', '\"FALSE\"'), ('EN_ECC_WRITE', '\"FALSE\"'),\n                                 ('RAM_EXTENSION_A', '\"NONE\"'), ('RAM_EXTENSION_B', '\"NONE\"')]:\n                assert self.parameters.get(key, default) == default\n            for pin in ('CASCADEINA', 'CASCADEINB', 'INJECTDBITERR', 'INJECTSBITERR'):\n                assert pin not in rendered and self.port_direction[pin] == 'input'\n                assert self.port_width[pin] is None\n                rendered[pin] = \"1'bz\"\n        if rendered:\n"
          }
        ]
      }
    ],
