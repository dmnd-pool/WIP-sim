@@ -0,0 +1,50 @@
+/* Recorded md-sim source adaptations. Original downloaded files are unchanged. */
+#ifndef MD_SIM_ADAPTATION_H
+#define MD_SIM_ADAPTATION_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <endian.h>
+
+static inline uint32_t md_sim_hash_prefix(const unsigned char hash[32])
+{
+    unsigned ofs = 0;
+    uint32_t word;
+    while (ofs < 28 && hash[ofs] == 0)
+        ++ofs;
+    memcpy(&word, hash + ofs, sizeof(word));
+    return be32toh(word);
+}
+
+struct md_sim_credits {
+    uint64_t sent, requested_sent, generation, requested_generation;
+    bool pending_status, pending_clean;
+};
+static inline void md_sim_clean(struct md_sim_credits *state)
+{
+    ++state->generation;
+    state->pending_clean = true;
+}
+static inline void md_sim_sent(struct md_sim_credits *state, unsigned count)
+{
+    state->sent += count;
+    state->pending_clean = false;
+}
+static inline void md_sim_status_requested(struct md_sim_credits *state)
+{
+    state->pending_status = true;
+    state->requested_sent = state->sent;
+    state->requested_generation = state->generation;
+}
+static inline unsigned md_sim_status_credits(struct md_sim_credits *state,
+                                             unsigned reported, unsigned current)
+{
+    if (!state->pending_status)
+        return current < reported ? current : reported;
+    state->pending_status = false;
+    if (state->requested_generation != state->generation)
+        return current;
+    uint64_t sent_after_request = state->sent - state->requested_sent;
+    return sent_after_request >= reported ? 0 : reported - sent_after_request;
+}
+#endif
