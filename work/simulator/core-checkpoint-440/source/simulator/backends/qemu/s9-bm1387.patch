+OBJECT_DECLARE_SIMPLE_TYPE(MdAsicMachineState, MD_ASIC_MACHINE)
+struct MdAsicMachineState {
+    ZynqMachineState parent_obj;
+    double hash_cap_hps;
+    bool hash_budget_started, fabric_clock_reference;
+};
+
+static char *md_asic_get_cap(Object *obj, Error **errp)
+{
+    return g_strdup_printf("%.17g", MD_ASIC_MACHINE(obj)->hash_cap_hps);
+}
+
+static void md_asic_set_cap(Object *obj, const char *value, Error **errp)
+{
+    if (MD_ASIC_MACHINE(obj)->hash_budget_started) {
+        error_setg(errp, "Hash cap is immutable after machine startup");
+        return;
+    }
+    char *end;
+    errno = 0;
+    double rate = g_ascii_strtod(value, &end);
+    if (errno || end == value || *end || !(rate > 0 && rate <= 1e9)) {
+        error_setg(errp, "Invalid aggregate hash-cap-hps");
+        return;
+    }
+    MdHashBudget *check = md_hash_budget_new(rate);
+    if (!check) {
+        error_setg(errp, "Hash cap exceeds supported clock range");
+        return;
+    }
+    md_hash_budget_free(check);
+    MD_ASIC_MACHINE(obj)->hash_cap_hps = rate;
+}
+
+static bool md_asic_get_fabric(Object *obj, Error **errp)
+{
+    return MD_ASIC_MACHINE(obj)->fabric_clock_reference;
+}
+
+static void md_asic_set_fabric(Object *obj, bool enabled, Error **errp)
+{
+    if (MD_ASIC_MACHINE(obj)->hash_budget_started) {
+        error_setg(errp, "Fabric fixture selection is immutable after startup");
+        return;
+    }
+    MD_ASIC_MACHINE(obj)->fabric_clock_reference = enabled;
+}
+
+static void md_asic_machine_class_init(ObjectClass *oc, const void *data)
+{
+    ObjectProperty *prop = object_class_property_add_str(oc, "hash-cap-hps",
+                                      md_asic_get_cap, md_asic_set_cap);
+    object_class_property_set_description(oc, "hash-cap-hps",
+        "Aggregate functional hashes per wall second across all three chains");
+    object_property_set_default_str(prop, "10000");
+    prop = object_class_property_add_bool(oc, "fabric-clock-reference",
+                                         md_asic_get_fabric, md_asic_set_fabric);
+    object_class_property_set_description(oc, "fabric-clock-reference",
+        "Explicit FCLK1 reference wiring; not selected firmware FPGA evidence");
+    object_property_set_default_bool(prop, false);
+}
 
