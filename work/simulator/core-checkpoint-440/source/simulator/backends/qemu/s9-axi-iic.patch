+++ b/configs/devices/arm-softmmu/mdsim.mak
@@ -0,0 +1,8 @@
+# Experimental S9 backend; other boards use separate declared backend profiles.
+CONFIG_ZYNQ=y
+# Pinned ARM CPU code unconditionally references the GICv5 implementation.
+CONFIG_ARM_GICV5=y
+# Existing Zynq machine declares unimplemented peripheral placeholders.
+CONFIG_UNIMP=y
+# Original SPL and project-owned reset probes use QEMU's existing loader.
+CONFIG_GENERIC_LOADER=y
