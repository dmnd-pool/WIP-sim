+static void md_pcap_realize(DeviceState *dev, Error **errp)
+{
+    XlnxZynqDevcfg *s = XLNX_ZYNQ_DEVCFG(dev);
+    if (!s->md_bitstream && !s->md_part) {
+        return;
+    }
+    if (!s->md_bitstream || !s->md_part) {
+        error_setg(errp, "Strict PCAP needs both md-bitstream and md-part");
+        return;
+    }
+    g_autofree char *bitstream = NULL;
+    g_autofree char *part = NULL;
+    gsize size, part_size;
+    struct stat st;
+    if (stat(s->md_bitstream, &st) || !S_ISREG(st.st_mode) ||
+        st.st_size <= 0 || st.st_size > 64 * MiB ||
+        stat(s->md_part, &st) || !S_ISREG(st.st_mode) ||
+        st.st_size <= 0 || st.st_size > MiB ||
+        !g_file_get_contents(s->md_bitstream, &bitstream, &size, NULL) ||
+        !g_file_get_contents(s->md_part, &part, &part_size, NULL)) {
+        error_setg(errp, "Cannot load bounded PCAP reference inputs");
+        return;
+    }
+    s->md_pcap = md_pcap_new((uint8_t *)bitstream, size,
+                             (uint8_t *)part, part_size);
+    if (!s->md_pcap) {
+        error_setg(errp, "PCAP reference configuration or part validation failed");
+    }
+}
+
+static void md_pcap_unrealize(DeviceState *dev)
+{
+    XlnxZynqDevcfg *s = XLNX_ZYNQ_DEVCFG(dev);
+    md_pcap_free(s->md_pcap);
+    s->md_pcap = NULL;
+}
