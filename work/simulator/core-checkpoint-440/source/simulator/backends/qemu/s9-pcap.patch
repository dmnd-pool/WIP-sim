+/* Explicit strict configuration contract. The existing generic QEMU model
+ * remains available, but cannot supply FPGA programming acceptance evidence.
+ * Transfers are synchronous as in upstream; PCAP clock calibration is open. */
+static bool md_pcap_transfer(XlnxZynqDevcfg *s)
+{
+    uint32_t address = s->regs[R_DMA_SRC_ADDR] & ~3u;
+    uint64_t size = (uint64_t)s->regs[R_DMA_SRC_LEN] * 4;
+    bool increment = !FIELD_EX32(s->regs[R_CFG], CFG, DISABLE_SRC_INC);
+    MdPcapProgress progress = {0};
+    uint32_t status = 0;
+    const char *failure = "unsupported PCAP DMA controls or address range";
+    s->regs[R_INT_STS] &= ~(R_INT_STS_DMA_DONE_MASK |
+                            R_INT_STS_DMA_P_DONE_MASK |
+                            R_INT_STS_PCFG_DONE_MASK);
+    if (!size || size > 64 * MiB ||
+        (increment && size > (1ULL << 32) - address) ||
+        s->regs[R_DMA_DST_ADDR] != 0xffffffff ||
+        s->regs[R_DMA_DST_LEN] ||
+        !FIELD_EX32(s->regs[R_CTRL], CTRL, PCAP_MODE) ||
+        !FIELD_EX32(s->regs[R_CTRL], CTRL, PCAP_PR) ||
+        FIELD_EX32(s->regs[R_MCTRL], MCTRL, INT_PCAP_LPBK)) {
+        goto rejected;
+    }
+    for (uint64_t offset = 0; offset < size;) {
+        uint8_t bytes[BTT_MAX];
+        /* DevC uses 32-bit AXI data. Keyhole mode reads the same word on
+         * every beat. Do not cache it: an MMIO source can have side effects. */
+        uint32_t count = increment ? MIN(sizeof(bytes), size - offset) : 4;
+        uint32_t source = address + (increment ? offset : 0);
+        if (dma_memory_read(&address_space_memory, source,
+                            bytes, count, MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            failure = "PCAP DMA source memory read failed";
+            goto rejected;
+        }
+        status = md_pcap_write(s->md_pcap, bytes, count, &progress);
+        if (!status) {
+            failure = md_pcap_error(s->md_pcap);
+            goto rejected;
+        }
+        offset += count;
+    }
+    s->regs[R_INT_STS] |= R_INT_STS_DMA_DONE_MASK | R_INT_STS_DMA_P_DONE_MASK;
+    if (status == 2) {
+        s->regs[R_INT_STS] |= R_INT_STS_PCFG_DONE_MASK;
+    }
+    fprintf(stderr, "md-sim-pcap: dma address=0x%x bytes=%" PRIu64
+            " received=%" PRIu64 " omitted_preamble=%" PRIu64
+            " complete=%u sha256=%s source_increment=%u\n",
+            address, size, progress.received, progress.omitted_preamble,
+            status == 2, progress.sha256, increment);
+    return true;
+rejected:
+    md_pcap_reject(s->md_pcap);
+    error_report("md-sim-pcap: rejected: %s", failure);
+    qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+    return false;
+}
