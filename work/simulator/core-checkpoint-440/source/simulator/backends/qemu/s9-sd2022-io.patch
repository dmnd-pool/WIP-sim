--- a/hw/arm/xilinx_zynq.c
+++ b/hw/arm/xilinx_zynq.c
@@ -390,12 +390,21 @@
     if (object_dynamic_cast(OBJECT(machine), MACHINE_TYPE_NAME("md-sim-s9-legacy-io-development"))) {
+        bool sd2022 = object_dynamic_cast(OBJECT(machine),
+                         MACHINE_TYPE_NAME("md-sim-s9-sd2022-io-development")) != NULL;
         /* Exact legacy system.tcl: S9IO IRQ_F2P bits6..14. Zynq maps
          * bits0..7 to absolute GIC61..68, bits8..15 to GIC84..91.
          * The README's generic base+2 statement misses this discontinuity. */
         static const unsigned interrupts[3][3] = {
             {67, 68, 84}, {85, 86, 87}, {88, 89, 90},
         };
+        /* Original2022 DTB550c8781...cb62a and actual guest IRQ registrations.
+         * This selects the declared address/interrupt layout only. Reusing
+         * the legacy controller core is an explicit development hypothesis. */
+        static const unsigned sd_interrupts[3][3] = {
+            {62, 63, 64}, {65, 66, 67}, {68, 84, 85},
+        };
         for (unsigned i = 0; i < 3; i++) {
             DeviceState *io = qdev_new("md-sim-s9io");
-            g_autofree char *name = g_strdup_printf("s9io%u", i + 5);
+            unsigned link = i + (sd2022 ? 6 : 5);
+            g_autofree char *name = g_strdup_printf("s9io%u", link);
             object_property_add_child(OBJECT(machine), name, OBJECT(io));
-            qdev_prop_set_uint32(io, "link-id", i + 5);
+            qdev_prop_set_uint32(io, "link-id", link);
@@ -406,4 +415,6 @@
-            sysbus_mmio_map(SYS_BUS_DEVICE(io), 0, 0x43c50000 + i * 0x10000);
+            sysbus_mmio_map(SYS_BUS_DEVICE(io), 0,
+                            (sd2022 ? 0x43c00000 : 0x43c50000) + i * 0x10000);
             for (unsigned j = 0; j < 3; j++) {
-                sysbus_connect_irq(SYS_BUS_DEVICE(io), j, pic[interrupts[i][j] - GIC_INTERNAL]);
+                unsigned irq = sd2022 ? sd_interrupts[i][j] : interrupts[i][j];
+                sysbus_connect_irq(SYS_BUS_DEVICE(io), j, pic[irq - GIC_INTERNAL]);
             }
@@ -644,3 +655,7 @@
 static void zynq_machine_register_types(void)
 {
+    static const TypeInfo sd2022_fixture = {
+        .name = MACHINE_TYPE_NAME("md-sim-s9-sd2022-io-development"),
+        .parent = MACHINE_TYPE_NAME("md-sim-s9-gpio-development"),
+    };
     static const TypeInfo gpio_fixture = {
@@ -667,2 +682,3 @@
     type_register_static(&gpio_fixture);
+    type_register_static(&sd2022_fixture);
 }
