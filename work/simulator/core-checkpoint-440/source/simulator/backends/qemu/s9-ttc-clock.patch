+/* The counter retains16 fractional bits. QEMU Clock retains32 fractional
+ * nanoseconds. Keep the division remainder so register polls cannot discard
+ * sub-counter time. All selected Zynq periods and prescalers fit in128bits. */
+static unsigned __int128 cadence_timer_period(CadenceTimerState *s)
+{
+    unsigned shift = (s->reg_clock & CLOCK_CTRL_PS_EN) ?
+        ((s->reg_clock & CLOCK_CTRL_PS_V) >> 1) + 1 : 0;
+    return (unsigned __int128)clock_get(s->pclk) << shift;
+}
+
+static unsigned __int128 cadence_timer_fraction(CadenceTimerState *s)
+{
+    return ((unsigned __int128)s->fraction_high << 64) | s->fraction_low;
+}
