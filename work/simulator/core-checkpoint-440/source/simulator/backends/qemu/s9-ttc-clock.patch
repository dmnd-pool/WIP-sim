+static void cadence_ttc_clock_update(void *opaque, ClockEvent event)
+{
+    CadenceTTCState *s = opaque;
+    if (!DEVICE(s)->realized) {
+        return;
+    }
+    for (int i = 0; i < 3; i++) {
+        CadenceTimerState *timer = &s->timer[i];
+        if (event == ClockPreUpdate) {
+            cadence_timer_sync(timer);
+        } else {
+            /* Keep the16.16 count; restart the smaller source-clock phase.
+             * This explicit transition policy is not physical calibration. */
+            cadence_timer_clear_fraction(timer);
+            timer->cpu_time = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+            timer->cpu_time_valid = 1;
+            cadence_timer_run(timer);
+        }
+    }
+}
