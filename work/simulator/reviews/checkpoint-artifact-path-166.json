{
  "schema": "md-sim-checkpoint-artifact-review/1",
  "finding": "The old helper lets Cargo inherit CARGO_TARGET_DIR but always copies target/release/libmd_sim_qemu_core.a. Source165 C ABI linking exposed the stale library. Historical copied library bytes and source snapshots remain intact; a source snapshot alone is not proof that its library came from that build.",
  "correction": "Source166 parses bounded Cargo compiler-artifact output for the exact model source path and staticlib target, requires one absolute library path, retains it with hashes and records the actual Cargo artifact log.",
  "scope": "Comparison uses currently retained build outputs; it does not infer historical source provenance from filenames or equal behavior. Existing actual firmware and independent hash observations retain their binary identities; unmatched model-build source claims need revalidation.",
  "first_observed_missing_symbol": "md_s9_temperature_input_plan",
  "invalid_checkpoint": "work/simulator/qemu-s9/core-checkpoint-165",
  "corrected_checkpoint": "work/simulator/qemu-s9/core-checkpoint-166",
