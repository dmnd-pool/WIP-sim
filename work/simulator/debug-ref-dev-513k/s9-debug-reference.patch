+/* A reference-only word contract. Let original requests reach validation
+ * before AddressSpace or the implementation can split them into words.
+ * The generic machine keeps the original slcr_ops unchanged. */
+static bool md_slcr_reference_access(void *opaque, hwaddr offset, unsigned size,
+                                     bool is_write, MemTxAttrs attrs)
+{
+    if (size != 4 || (offset & 3)) {
+        error_report("md-sim: unsupported ROM SLCR %s size%u at0x%"
+                     HWADDR_PRIx, is_write ? "write" : "read", size, offset);
+        qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+        return false;
+    }
+    return true;
+}
+
 static const MemoryRegionOps slcr_ops = {
     .read = zynq_slcr_read,
     .write = zynq_slcr_write,
     .endianness = DEVICE_NATIVE_ENDIAN,
+};
+
+static const MemoryRegionOps slcr_reference_ops = {
+    .read = zynq_slcr_read,
+    .write = zynq_slcr_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8,
+               .unaligned = true, .accepts = md_slcr_reference_access },
+    .impl = { .min_access_size = 1, .max_access_size = 8, .unaligned = true },
 };
 
