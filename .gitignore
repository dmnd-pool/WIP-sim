# Build products and dependency caches. Keep vendor/ for offline Rust builds.
target/
node_modules/
__pycache__/
*.py[cod]
/.cache/

# Local agent state and credentials. Keep public sample configurations.
/.aws/
/.codex/
/.agents/
/.ssh/
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
*.p12
*.pfx
*.keystore

# Original payloads and derived source extracts stay in the local archive.
# Keep artifacts/manifests/ and catalog/parts/ as source records.
/artifacts/files/
/sources/

# Rebuilt catalogue databases, exports and browser. See README build commands.
/catalog/*.sqlite
/catalog/*.sqlite-*
/catalog/index.html
/catalog/csv/
/catalog/artifacts.jsonl
/catalog/entities.jsonl
/catalog/gaps.jsonl
/catalog/relationships.jsonl
/catalog/sources.jsonl
/reports/archive-members/
/reports/*.log

# Run data, disks, downloaded tools and credentials stay local. Allow only
# durable notes, compact authored reports, paused source work and check logs.
/work/*
!/work/simulator/
/work/simulator/*
!/work/simulator/*.md
!/work/simulator/reports/
!/work/simulator/reviews/
/work/simulator/reviews/*
!/work/simulator/reviews/*.md
!/work/simulator/reviews/*.json
!/work/simulator/reviews/*.sha256
!/work/simulator/reviews/bm1397-programmed-501.patch
!/work/simulator/cleanup-development-455/
!/work/simulator/shared-recovery-development-459/
!/work/simulator/milestone-1.2-checkpoint/

# Retain the exact source and build manifests for passed run441. Binaries,
# static libraries and raw execution data remain in the workspace archive.
!/work/simulator/core-checkpoint-440/
/work/simulator/core-checkpoint-440/*
!/work/simulator/core-checkpoint-440/source/
!/work/simulator/core-checkpoint-440/manifest.json
!/work/simulator/channel-target-440/
/work/simulator/channel-target-440/*
!/work/simulator/channel-target-440/SHA256SUMS

# Checkpoint500 build identities. Keep executable payloads and source copies local.
!/work/simulator/core-checkpoint-494/
/work/simulator/core-checkpoint-494/*
!/work/simulator/core-checkpoint-494/manifest.json
!/work/simulator/core-checkpoint-499/
/work/simulator/core-checkpoint-499/*
!/work/simulator/core-checkpoint-499/manifest.json
!/work/simulator/core-checkpoint-500/
/work/simulator/core-checkpoint-500/*
!/work/simulator/core-checkpoint-500/manifest.json
!/work/simulator/channel-target-499/
/work/simulator/channel-target-499/*
!/work/simulator/channel-target-499/cohort.json
!/work/simulator/channel-target-499/SHA256SUMS
!/work/simulator/cli-tools-500/
/work/simulator/cli-tools-500/*
!/work/simulator/cli-tools-500/build.json

# Compact verified source checkpoint. Keep runtime payloads and credentials out.
!/work/simulator/source-checkpoint-511e/
/work/simulator/source-checkpoint-511e/*
!/work/simulator/source-checkpoint-511e/manifest.json
!/work/simulator/source-checkpoint-511e/fmt.log
!/work/simulator/source-checkpoint-511e/clippy.log
!/work/simulator/source-checkpoint-511e/tests.log
!/work/simulator/source-checkpoint-511e/guide-links.log
!/work/simulator/source-checkpoint-516/
/work/simulator/source-checkpoint-516/*
!/work/simulator/source-checkpoint-516/manifest.json
!/work/simulator/source-checkpoint-516/fmt.log
!/work/simulator/source-checkpoint-516/clippy.log
!/work/simulator/source-checkpoint-516/tests.log
!/work/simulator/source-checkpoint-516/guide-links.log
!/work/simulator/source-checkpoint-516/source-inputs.json
